<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
        x:Class="MMM.WarningWindow"
        SystemDecorations="None"
        Title="MMM" Background="#232323" 
        Icon="avares://MMM/Resources/icon/mmm-icon.png"
        Width="300" Height="150" 
        MinHeight="150" MinWidth="300"
        MaxHeight="150" MaxWidth="300"
        CanMaximize="False" CanMinimize="False"
        CanResize="False">
    <Grid>
        <Border BorderBrush="#373737" BorderThickness="1">
            <Rectangle HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Margin="3"
                       Fill="#141414"
                       Stroke="#373737"
                       StrokeThickness="1" />
        </Border>

        <Rectangle Name="DragImage"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Margin="4"
                   Stroke="#373737"
                   StrokeThickness="1">
            <Rectangle.Fill>
                <ImageBrush Source="avares://MMM/Resources/images/pattern.png"
                            TileMode="Tile"
                            Stretch="None"
                            DestinationRect="0,0,100,100" />
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Rectangle Height="1"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       Margin="6 7 6 0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%, 0%">
                        <GradientStop Color="#6b9cc6" Offset="0.1" />
                        <GradientStop Color="#9779bb" Offset="0.25" />
                        <GradientStop Color="#b872ab" Offset="0.5" />
                        <GradientStop Color="#cb9d8d" Offset="0.75" />
                        <GradientStop Color="#ddc37b" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="1"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       Margin="6 8 6 0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%, 0%">
                        <GradientStop Color="#2a313f" Offset="0.1" />
                        <GradientStop Color="#38253c" Offset="0.25" />
                        <GradientStop Color="#423031" Offset="0.5" />
                        <GradientStop Color="#494025" Offset="0.75" />
                        <GradientStop Color="#494025" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="20 30 20 25">
                <Border Background="#171717"
                        BorderBrush="#303030"
                        BorderThickness="1" />

                <Grid Width="105"
                      Height="21"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="-12 -10 0 0">
                    <Rectangle Width="55"
                               Height="1"
                               Fill="#141414"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0 10 0 0" />
                    <TextBlock Text="Warning"
                               Foreground="#DCDCDC"
                               FontSize="11"
                               FontWeight="Bold"
                               FontFamily="Verdana"
                               Margin=" 0 -20 0 0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" />
                </Grid>

                <Grid Margin="15 10 0 10" RowDefinitions="30,*,30">
                    <Label Name="Label"
                           Grid.Row="0"
                           Foreground="#c0c1c1"
                           FontSize="14"
                           FontFamily="Verdana"
                           Padding="0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top">Are you sure?
                    </Label>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Spacing="5"
                                Margin="0 0 10 0">
                        <Button Name="No" Click="No_OnClick"
                                Width="65" Height="30"
                                Background="#1e1e1e"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Padding="0">
                            <Border BorderBrush="#303030"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                                        <GradientStop Color="#232323" Offset="0" />
                                        <GradientStop Color="#191919" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="No"
                                           Foreground="#c0c1c1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontFamily="Verdana" />
                            </Border>
                        </Button>

                        <Button Name="Yes" Click="Yes_OnClick"
                                Width="65" Height="30"
                                Background="#1e1e1e"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Padding="0">
                            <Border BorderBrush="#303030"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                                        <GradientStop Color="#232323" Offset="0" />
                                        <GradientStop Color="#191919" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="Yes"
                                           Foreground="#c0c1c1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontFamily="Verdana" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
