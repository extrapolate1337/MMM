<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
        x:Class="aimware.SecondWindow"
        SystemDecorations="None"
        Title="MMM" Background="#232323" Width="300" Height="450" MaxHeight="450" MaxWidth="300"
        MinHeight="450" MinWidth="300">
    <Grid>
        <Border BorderBrush="#373737" BorderThickness="1">
            <Rectangle Width="292" Height="442"
                       HorizontalAlignment="Center"
                       Margin="4 4 4 4"
                       Fill="#141414"
                       Stroke="#373737"
                       StrokeThickness="1" />
        </Border>
        <Rectangle Name="DragImage" Width="292" Height="442"
                   HorizontalAlignment="Center"
                   Margin="4 4 4 4"
                   Stroke="#373737"
                   StrokeThickness="1">
            <Rectangle.Fill>
                <ImageBrush Source="info.png"
                            TileMode="Tile"
                            Stretch="UniformToFill" />
            </Rectangle.Fill>
        </Rectangle>
        <Grid>
            <Rectangle Width="288"
                       Height="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0 7 0 0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="3,30">
                        <GradientStop Color="#6b9cc6" Offset="0.1" />
                        <GradientStop Color="#9779bb" Offset="0.25" />
                        <GradientStop Color="#b872ab" Offset="0.5" />
                        <GradientStop Color="#cb9d8d" Offset="0.75" />
                        <GradientStop Color="#ddc37b" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="288"
                       Height="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0 8 0 0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="3,90">
                        <GradientStop Color="#2a313f" Offset="0.1" />
                        <GradientStop Color="#38253c" Offset="0.25" />
                        <GradientStop Color="#423031" Offset="0.5" />
                        <GradientStop Color="#494025" Offset="0.75" />
                        <GradientStop Color="#494025" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Fill="#171717"
                       Width="260" Height="290"
                       Stroke="#303030" StrokeThickness="1"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="20 30 0 0" />
            <Rectangle Fill="#141414"
                       Width="72" Height="1"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="51 30 0 0" />
            <Label Foreground="#c0c1c1"
                   Width="105"
                   Height="21"
                   FontSize="11"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Bottom"
                   FontFamily="Verdana"
                   Margin="35 21 0 0">
                Additionally
            </Label>

            <Rectangle Fill="#171717"
                       Width="260" Height="75"
                       Stroke="#303030" StrokeThickness="1"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="20 1 1 30" />

            <Rectangle Fill="#141414"
                       Width="38" Height="1"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="51 1 1 104" />
            <Label Foreground="#c0c1c1"
                   Width="105"
                   Height="21"
                   FontSize="11"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Bottom"
                   FontFamily="Verdana"
                   Margin="18 1 1 93">
                Extra
            </Label>

            <Button Name="CloseAdditionally" Click="CloseAdditionally_OnClick"
                    Background="#1e1e1e"
                    Width="120" Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="90 1 1 50"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="Close Window"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Label Foreground="#c0c1c1"
                   Width="105"
                   Height="21"
                   FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Bottom"
                   FontFamily="Verdana"
                   Margin="1 240 60 1">
                Creator:
            </Label>
            <TextBlock Text="Wifu-OS"
                       FontSize="14"
                       FontFamily="Verdana"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="60 243 1 1">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,19">
                        <GradientStop Color="#b872ab" Offset="0" />
                        <GradientStop Color="#ddc37b" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>

            <Label Foreground="#c0c1c1"
                   Width="105"
                   Height="21"
                   FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Bottom"
                   FontFamily="Verdana"
                   Margin="1 265 50 1">
                Version:
            </Label>
            <TextBlock Text="  1.3.3.7"
                       FontSize="14"
                       FontFamily="Verdana"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="50 268 1 1">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,19">
                        <GradientStop Color="#b872ab" Offset="0" />
                        <GradientStop Color="#ddc37b" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <Rectangle Fill="#141414"
                       Width="154" Height="152"
                       Stroke="#303030" StrokeThickness="1"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0 58 0 0" />
            <Image Source="pattern.jpg"
                   Width="150"
                   Height="150"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0 60 0 0" />
        </Grid>
    </Grid>
</Window>