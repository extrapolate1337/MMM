<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="aimware.MainWindow"
        SystemDecorations="None"
        Title="MMM" Background="#232323" Width="800" Height="450" MaxHeight="450" MaxWidth="800"
        MinHeight="450" MinWidth="800">
    <Grid>
        <Border BorderBrush="#373737" BorderThickness="1">
            <Rectangle Width="792" Height="442"
                       HorizontalAlignment="Center"
                       Margin="4 4 4 4"
                       Fill="#141414"
                       Stroke="#373737"
                       StrokeThickness="1" />
        </Border>

        <Rectangle Name="DragImage" Width="792" Height="442"
                   HorizontalAlignment="Center"
                   Margin="4 4 4 4"
                   Stroke="#373737"
                   StrokeThickness="1">
            <Rectangle.Fill>
                <ImageBrush Source="mainwind.png"
                            TileMode="None"
                            Stretch="UniformToFill" />
            </Rectangle.Fill>
        </Rectangle>
        <Grid>
            <Rectangle Width="788"
                       Height="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0 7 0 0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,30">
                        <GradientStop Color="#6b9cc6" Offset="0.1" />
                        <GradientStop Color="#9779bb" Offset="0.25" />
                        <GradientStop Color="#b872ab" Offset="0.5" />
                        <GradientStop Color="#cb9d8d" Offset="0.75" />
                        <GradientStop Color="#ddc37b" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="788"
                       Height="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0 8 0 0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,30">
                        <GradientStop Color="#2a313f" Offset="0.1" />
                        <GradientStop Color="#38253c" Offset="0.25" />
                        <GradientStop Color="#423031" Offset="0.5" />
                        <GradientStop Color="#494025" Offset="0.75" />
                        <GradientStop Color="#494025" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Fill="#171717"
                       Width="180" Height="100"
                       Stroke="#303030" StrokeThickness="1"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="1 1 20 30" />
            <Rectangle Fill="#171717"
                       Width="180" Height="270"
                       Stroke="#303030" StrokeThickness="1"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="1 30 20 1" />
            <Rectangle Fill="#171717"
                       Width="560" Height="390"
                       Stroke="#303030" StrokeThickness="1"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="20 30 0 0" />

            <Rectangle Fill="#141414"
                       Width="37" Height="1"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0 0 148 129" />
            <Label Foreground="#c0c1c1"
                   Width="35"
                   Height="18"
                   FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Bottom"
                   FontFamily="Verdana"
                   Margin="0 0 149 123">
                Extra
            </Label>
            <Rectangle Fill="#141414"
                       Width="65" Height="1"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="1 30 116 1" />
            <Label Foreground="#c0c1c1"
                   Width="70"
                   Height="18"
                   FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Bottom"
                   FontFamily="Verdana"
                   Margin="0 21 114 0">
                ModPacks
            </Label>
            <Rectangle Fill="#141414"
                       Width="100" Height="1"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="38 30 0 0" />
            <Label Foreground="#c0c1c1"
                   Width="105"
                   Height="21"
                   FontSize="11"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Bottom"
                   FontFamily="Verdana"
                   Margin="35 21 0 0">
                Addons Manager
            </Label>

            <Button Name="Run" Click="Run_OnClick"
                    IsEnabled="True"
                    Background="#1e1e1e"
                    Width="100" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="1 1 43 80"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="Start"
                               Name="RunText"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Button Name="Exit" Click="Exit_OnClick"
                    Background="#1e1e1e"
                    Width="100" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="1 1 43 45"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="Exit"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>


            <ListBox Name="ListBox" IsVisible="False"
                     SelectionChanged="ListBox_OnSelectionChanged"
                     Background="#1e1e1e" Foreground="#c0c1c1"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="1 44 30 1"
                     SelectionMode="Single"
                     Width="160" Height="35"
                     MaxWidth="160" MaxHeight="300"
                     BorderBrush="#303030"
                     BorderThickness="1">
                <ListBox.Styles>
                    <Style Selector="ScrollBar">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Background" Value="#1e1e1e" />
                    </Style>
                    <Style Selector="ScrollBar Thumb">
                        <Setter Property="Background" Value="#7bc330" />
                        <Setter Property="CornerRadius" Value="100" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#191919" />
                        <Setter Property="Foreground" Value="#7bc330" />
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <TextBox Name="TextBox" TextChanged="TextBox_OnTextChanged"
                     IsVisible="False"
                     Watermark="ModPack Name"
                     Height="10" Width="155"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin=" 160 1 1 45"
                     Background="#191919" Foreground="#c0c1c1"
                     BorderBrush="#303030"
                     BorderThickness="1"
                     CornerRadius="0"
                     FontFamily="Verdana" FontSize="12">
                <TextBox.Styles>
                    <Style Selector="TextBox:focus /template/ Border">
                        <Setter Property="BorderBrush" Value="#7bc330" />
                        <Setter Property="BorderThickness" Value="1 1 1 1" />
                        <Setter Property="Background" Value="#191919" />
                    </Style>
                </TextBox.Styles>
            </TextBox>

            <ListBox Name="ListBoxContent" IsVisible="True"
                     SelectionChanged="ListBoxContent_OnSelectionChanged"
                     Background="#1e1e1e" Foreground="#c0c1c1"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="1 46 201 1"
                     SelectionMode="Multiple"
                     Width="530" Height="316"
                     MaxWidth="530" MaxHeight="316"
                     BorderBrush="#303030"
                     BorderThickness="1">
                <ListBox.Styles>
                    <Style Selector="ScrollBar">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Background" Value="#1e1e1e" />
                    </Style>
                    <Style Selector="ScrollBar Thumb">
                        <Setter Property="Background" Value="#7bc330" />
                        <Setter Property="CornerRadius" Value="100" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#191919" />
                        <Setter Property="Foreground" Value="#7bc330" />
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <ListBox Name="ListBoxMenager" IsVisible="False"
                     SelectionChanged="ListBoxMenager_OnSelectionChanged"
                     Background="#1e1e1e" Foreground="#c0c1c1"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="35 46 1 1"
                     SelectionMode="Single"
                     Width="262" Height="316"
                     MaxWidth="530" MaxHeight="316"
                     BorderBrush="#303030"
                     BorderThickness="1">
                <ListBox.Styles>
                    <Style Selector="ScrollBar">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Background" Value="#1e1e1e" />
                    </Style>
                    <Style Selector="ScrollBar Thumb">
                        <Setter Property="Background" Value="#7bc330" />
                        <Setter Property="CornerRadius" Value="100" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#191919" />
                        <Setter Property="Foreground" Value="#7bc330" />
                    </Style>
                </ListBox.Styles>
            </ListBox>


            <Button Name="Copy" Click="CopyMode_OnClick"
                    IsVisible="False"
                    Background="#1e1e1e"
                    Width="80" Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="260 1 1 45"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Name="CopyText"
                               Text="Copy"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Button Name="Move" Click="Move_OnClick"
                    IsVisible="False"
                    Background="#1e1e1e"
                    Width="80" Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="91 1 1 45"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Name="MoveText"
                               Text="Move"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Button Name="ActiveButton" Click="ActiveButton_OnClick"
                    IsVisible="False"
                    Background="#1e1e1e"
                    Width="80" Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="1 1 81 45"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="Disable"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Button Name="AddCollection" Click="AddCollection_OnClick"
                    Background="#1e1e1e"
                    Width="120" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="1 50 50 1"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="+"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Button Name="SubCollection" Click="SubCollection_OnClick"
                    IsVisible="False"
                    Background="#1e1e1e"
                    Width="60" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="1 80 50 1"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="-"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Button Name="AddAddon" Click="AddAddon_OnClick"
                    Background="#1e1e1e"
                    Width="60" Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="30 1 1 45"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="+"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>
            <Button Name="SubAddon" Click="SubAddon_OnClick"
                    Background="#1e1e1e"
                    Width="60" Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="95 1 1 45"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="-"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Button Name="Additionally" Click="Additionally_OnClick"
                    Background="#1e1e1e"
                    Width="30" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="1 1 148 45"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="⚙️"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>

            <Button Name="Floder" Click="Floder_OnClick"
                    Background="#1e1e1e"
                    Width="30" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="1 1 148 80"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="0">

                <Border BorderBrush="#303030"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,25">
                            <GradientStop Color="#232323" Offset="0" />
                            <GradientStop Color="#191919" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="📁"
                               Foreground="#c0c1c1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontFamily="Verdana" />
                </Border>
            </Button>
        </Grid>
    </Grid>
</Window>